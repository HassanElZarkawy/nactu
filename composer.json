{
  "name": "hassanelzarkawy/nactu",
  "description": "A Command Bus implementation with middleware pipeline, query caching, and retry support for Laravel",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "role": "Developer",
      "name": "Hassan El-Zarkawy",
      "email": "hassan.elzarkawy@gmail.com",
      "homepage": "https://www.github.com/HassanElZarkawy"
    }
  ],
  "autoload": {
    "psr-4": {
      "Nactu\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nactu\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.4",
    "illuminate/cache": "^13.11",
    "illuminate/console": "^13.11",
    "illuminate/container": "^13.11",
    "illuminate/support": "^13.11"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "optimize-autoloader": true
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.4",
    "laravel/pint": "^1.29",
    "orchestra/testbench": "^11.1",
    "phpunit/phpunit": "^13.1"
  },
  "scripts": {
    "analyse": "./vendor/bin/phpstan analyse",
    "bench": "@php benchmarks/bench.php",
    "format": [
      "./vendor/bin/rector",
      "./vendor/bin/pint"
    ],
    "test": "./vendor/bin/phpunit --do-not-record-test-run-history",
    "test-coverage": "php -d pcov.directory=src ./vendor/bin/phpunit --coverage-text --do-not-record-test-run-history"
  }
}
